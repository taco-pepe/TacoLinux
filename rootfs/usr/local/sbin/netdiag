#!/bin/sh
export LC_ALL=C NO_COLOR=1
{
echo "=== NETDIAG $(date -u)"
echo "A: $(ip -o -4 addr show scope global 2>&1 | tr '\n' '|')"
echo "R: $(ip -o route 2>&1 | tr '\n' '|')"
timeout 6 ping -c 1 -W 2 10.0.2.2 >/dev/null 2>&1 && echo "Pgw: OK" || echo "Pgw: FAIL"
timeout 8 ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1 && echo "P8: OK" || echo "P8: FAIL"
timeout 10 curl -m 8 -s -o /dev/null -w "curl archlinux.org http=%{http_code}\n" https://archlinux.org || echo "curl archlinux.org FAIL"
echo "N: $(timeout 12 timedatectl show -p NTPSynchronized 2>/dev/null || echo unsync)"
echo "S: $(timeout 3 systemctl is-system-running 2>/dev/null || echo unknown)"
echo "=== NETDIAG END"
} > /dev/ttyS0 2>&1