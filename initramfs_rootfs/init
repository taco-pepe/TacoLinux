#!/bin/busybox sh

export PATH=/bin:/sbin

BB=/bin/busybox
ROOT=/newroot

$BB mount -t devtmpfs devtmpfs /dev
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys

echo "[TacoLinux] Alpine initramfs started"

mkdir -p "$ROOT"

# Wait for devices
echo "[TacoLinux] Waiting for block devices..."
$BB sleep 2

# Find available partitions
list_parts() {
    for dev in /dev/sd* /dev/vd* /dev/nvme*n*p* /dev/mmcblk*p*; do
        [ -b "$dev" ] || continue

        info=$(/sbin/blkid "$dev" 2>/dev/null)
        [ -n "$info" ] || continue

        echo "$dev | $info"
    done
}

echo
echo "================================"
echo "       TacoLinux Boot"
echo "================================"
echo
echo "Available partitions:"
echo

list_parts

# Resolve a root= value from the kernel command line to a block device.
# GRUB passes root=UUID=<uuid>; a plain device path is also accepted.
resolve_root() {
    case "$1" in
        UUID=*)
            want="${1#UUID=}"
            for dev in /dev/sd* /dev/vd* /dev/nvme*n*p* /dev/mmcblk*p*; do
                [ -b "$dev" ] || continue
                # BusyBox blkid has no -s/-o flags; parse its output instead.
                uuid=$(/sbin/blkid "$dev" 2>/dev/null \
                       | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')
                if [ "$uuid" = "$want" ]; then
                    echo "$dev"
                    return 0
                fi
            done
            return 1
            ;;
        *)
            [ -b "$1" ] && { echo "$1"; return 0; }
            return 1
            ;;
    esac
}

# Use root= from the kernel command line when GRUB supplies it; otherwise
# fall back to prompting.
CMDLINE_ROOT=""
for arg in $(cat /proc/cmdline 2>/dev/null); do
    case "$arg" in
        root=*) CMDLINE_ROOT="${arg#root=}" ;;
    esac
done

ROOTDEV=""
if [ -n "$CMDLINE_ROOT" ]; then
    ROOTDEV=$(resolve_root "$CMDLINE_ROOT")
    if [ -n "$ROOTDEV" ]; then
        echo "[TacoLinux] Using root from kernel cmdline: $CMDLINE_ROOT -> $ROOTDEV"
    else
        echo "[TacoLinux] WARNING: could not resolve root=$CMDLINE_ROOT"
    fi
fi

if [ -z "$ROOTDEV" ]; then
    echo
    echo "Enter the root partition (example: /dev/sda2)"
    printf "Root partition: "
    read ROOTDEV
fi

if [ ! -b "$ROOTDEV" ]; then
    echo "[TacoLinux] ERROR: Invalid block device"
    exec $BB sh
fi

echo "[TacoLinux] Mounting $ROOTDEV"

if ! $BB mount -t ext4 -o rw "$ROOTDEV" "$ROOT"; then
    echo "[TacoLinux] ERROR: Root mount failed"
    exec $BB sh
fi

# Verify systemd exists
if [ ! -x "$ROOT/usr/lib/systemd/systemd" ]; then
    echo "[TacoLinux] ERROR: No systemd installation found!"
    $BB umount "$ROOT"
    exec $BB sh
fi

mkdir -p "$ROOT/dev" "$ROOT/proc" "$ROOT/sys" "$ROOT/run"

# Move kernel filesystems
$BB mount --move /dev "$ROOT/dev" || exec $BB sh
$BB mount --move /proc "$ROOT/proc" || exec $BB sh
$BB mount --move /sys "$ROOT/sys" || exec $BB sh

echo
echo "[TacoLinux] Switching to TacoLinux systemd"

exec /sbin/switch_root "$ROOT" /usr/lib/systemd/systemd

echo "[TacoLinux] ERROR: switch_root failed"
exec $BB sh
